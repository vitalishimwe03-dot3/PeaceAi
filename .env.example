# ============================================================
# PeaceAI frontend (browser-visible values only)
# Copy this file to .env and fill in values from your Supabase project.
# NEVER put a service-role key, AI key, or payment secret in VITE_* variables.
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173
VITE_SUPPORT_EMAIL=vitalishimwe03@gmail.com
VITE_SUPPORT_PHONE=0792448989

# ============================================================
# Supabase Edge Function secrets
# Set these with: supabase secrets set --env-file supabase/.env.functions
# Do not commit the filled .env.functions file.
# ============================================================

# AI (any OpenAI-compatible chat-completions endpoint)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PREMIUM_MODEL=gpt-4o
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=45000

# Optional embeddings endpoint (defaults to the AI base URL when omitted)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Flutterwave (Rwanda-compatible cards + mobile money). Test in sandbox first.
PAYMENTS_PROVIDER=flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Transactional email via Resend
RESEND_API_KEY=
EMAIL_FROM=PeaceAI <notifications@your-verified-domain.com>
ADMIN_ALERT_EMAIL=vitalishimwe03@gmail.com

# Public site URL used for payment redirects and links
SITE_URL=http://localhost:5173

# Used only by trusted server-side jobs; never expose to the browser.
INTERNAL_JOB_SECRET=
